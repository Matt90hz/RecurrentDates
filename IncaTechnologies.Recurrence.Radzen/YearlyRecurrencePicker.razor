<RadzenStack Visible=@Visible>
    <RadzenFormField Text=@MonthsSelectionDropDownCaption>
        <ChildContent>
            <RadzenDropDown Name="ddMesi"
                            @bind-Value=_selectedMonths
                            TextProperty="Text"
                            Data=_months
                            Multiple=true
                            AllowSelectAll=false
                            Disabled=@Disabled
                            Change=OnChanged />
        </ChildContent>
        <Helper>
            <RadzenRequiredValidator Component="ddMesi" />
        </Helper>
    </RadzenFormField>
    @foreach (var month in _selectedMonths)
    {
        <RadzenFieldset Text=@month.Text>
            <MonthlyRecurrencePicker @bind-Value=month.MonthlyRecurrence Disabled=@Disabled Change=OnChanged />
        </RadzenFieldset>
    }
</RadzenStack>

@inherits FormComponent<IYearly?>
@using IncaTechnologies.Recurrence
@code {

    [Parameter]
    public string? MonthsSelectionDropDownCaption { get => field ?? Localize(nameof(RecurrenceStrings.Inca_InMonths)); set; }

    [Parameter]
    public string? JanuaryText { get => field ?? Localize(nameof(RecurrenceStrings.Inca_Month_January)); set; }

    [Parameter]
    public string? FebruaryText { get => field ?? Localize(nameof(RecurrenceStrings.Inca_Month_February)); set; }

    [Parameter]
    public string? MarchText { get => field ?? Localize(nameof(RecurrenceStrings.Inca_Month_March)); set; }

    [Parameter]
    public string? AprilText { get => field ?? Localize(nameof(RecurrenceStrings.Inca_Month_April)); set; }

    [Parameter]
    public string? MayText { get => field ?? Localize(nameof(RecurrenceStrings.Inca_Month_May)); set; }

    [Parameter]
    public string? JuneText { get => field ?? Localize(nameof(RecurrenceStrings.Inca_Month_June)); set; }

    [Parameter]
    public string? JulyText { get => field ?? Localize(nameof(RecurrenceStrings.Inca_Month_July)); set; }

    [Parameter]
    public string? AugustText { get => field ?? Localize(nameof(RecurrenceStrings.Inca_Month_August)); set; }

    [Parameter]
    public string? SeptemberText { get => field ?? Localize(nameof(RecurrenceStrings.Inca_Month_September)); set; }

    [Parameter]
    public string? OctoberText { get => field ?? Localize(nameof(RecurrenceStrings.Inca_Month_October)); set; }

    [Parameter]
    public string? NovemberText { get => field ?? Localize(nameof(RecurrenceStrings.Inca_Month_November)); set; }

    [Parameter]
    public string? DecemberText { get => field ?? Localize(nameof(RecurrenceStrings.Inca_Month_December)); set; }

    private sealed class MonthViewModel(int month, string text)
    {
        public string Text { get; } = text;
        public int Month { get; } = month;
        public IMonthly? MonthlyRecurrence { get; set; }
    }

    private IEnumerable<MonthViewModel> _months = [];
    private IEnumerable<MonthViewModel> _selectedMonths = [];

    protected override void OnInitialized()
    {
        _months =
        [
            new(1, JanuaryText ?? "January"),
            new(2, FebruaryText ?? "February"),
            new(3, MarchText ?? "March"),
            new(4, AprilText ?? "April"),
            new(5, MayText ?? "May"),
            new(6, JuneText ?? "June"),
            new(7, JulyText ?? "July"),
            new(8, AugustText ?? "August"),
            new(9, SeptemberText ?? "September"),
            new(10, OctoberText ?? "October"),
            new(11, NovemberText ?? "November"),
            new(12, DecemberText ?? "December")
        ];
    }

    private async Task OnChanged()
    {
        Value = GenerateRecurrence(_selectedMonths);

        await ValueChanged.InvokeAsync(Value);
        await Change.InvokeAsync(Value);
    }

    private static IYearly? GenerateRecurrence(IEnumerable<MonthViewModel> viewModels)
    {
        if (viewModels.Any() is false) return null;

        var yearly = Occurs.EveryYear().In(@in =>
        {
            foreach (var vm in viewModels)
            {
                Month(@in, vm.Month).The(the =>
                {
                    vm.MonthlyRecurrence.ForEachTheDay(x => the
                        .Day(x.DayOfMonth)
                        .At(at => x.Then.ForEachAt(x => at.Hour(x.Hour).Minute(x.Minute).Second(x.Second))));

                    vm.MonthlyRecurrence.ForEachTheWeekDay(x => the
                        .SetDayInMonth(x.DayInMonth, x.DayOfWeek)
                        .At(at => x.Then.ForEachAt(x => at.Hour(x.Hour).Minute(x.Minute).Second(x.Second))));
                });
            }
        });

        return (IYearly)yearly.GetRoot();
    }

    private static IWeekly Month(IMonthly monthly, int month) => month switch
    {
        1 => monthly.January(),
        2 => monthly.February(),
        3 => monthly.March(),
        4 => monthly.April(),
        5 => monthly.May(),
        6 => monthly.June(),
        7 => monthly.July(),
        8 => monthly.August(),
        9 => monthly.September(),
        10 => monthly.October(),
        11 => monthly.November(),
        12 => monthly.December(),
        _ => throw new ArgumentOutOfRangeException(nameof(month), month, "The month must be between 1 and 12.")
    };
}
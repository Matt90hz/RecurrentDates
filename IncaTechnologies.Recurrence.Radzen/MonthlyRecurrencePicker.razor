<RadzenStack>
    <RadzenStack Orientation="Orientation.Horizontal">
        <RadzenButton Text="Specifica giorno" Size="ButtonSize.ExtraSmall" Variant="Variant.Text" Click="OnAggiungiGiornoClick" />
        <RadzenButton Text="Specifica settimana" Size="ButtonSize.ExtraSmall" Variant="Variant.Text" Click="OnAggiungiSettimanaClick" />
    </RadzenStack>
    <RadzenStack Gap="0.5rem">
        @foreach (var (i, vm) in _viewModels.Index())
        {
            <RadzenFieldset Style="padding-top: 0.5rem">

                <RadzenStack>

                    <div style="display:flex; gap: 1rem">

                        @if (vm is DayOfMonthViewModel dayOfMonth)
                        {
                            <RadzenFormField Text="Il" Style="flex-grow: 1">
                                <ChildContent>
                                    <RadzenNumeric Name=@($"nuGiornoNelMese{i}")
                                                   @bind-Value=dayOfMonth.DayOfMonth
                                                   TValue="int?"
                                                   Min="1"
                                                   Max="31"
                                                   Step="1"
                                                   Change=OnRecurrenceChanged />
                                </ChildContent>
                                <Helper>
                                    <RadzenRequiredValidator Component=@($"nuGiornoNelMese{i}") />
                                </Helper>
                            </RadzenFormField>
                        }
                        else if (vm is WeekOfMonthViewModel weekOfMonth)
                        {
                            <RadzenRow Style="flex-grow: 1">
                                <RadzenColumn>
                                    <RadzenFormField class="rz-w-100" Text="La">
                                        <ChildContent>
                                            <RadzenDropDown Name=@($"ddSettimanaNelMese{i}")
                                                            @bind-Value=weekOfMonth.WeekOfMonth
                                                            Data=_weeksOfMonth
                                                            Change=OnRecurrenceChanged />
                                        </ChildContent>
                                        <Helper>
                                            <RadzenRequiredValidator Component=@($"ddSettimanaNelMese{i}") />
                                        </Helper>
                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn>
                                    <RadzenFormField class="rz-w-100" Text="Di">
                                        <ChildContent>
                                            <RadzenDropDown Name=@($"ddGiornoDellaSettimana{i}")
                                                            @bind-Value=weekOfMonth.DayOfWeek
                                                            Data=_daysOfWeek
                                                            Change=OnRecurrenceChanged />
                                        </ChildContent>
                                        <Helper>
                                            <RadzenRequiredValidator Component=@($"ddGiornoDellaSettimana{i}") />
                                        </Helper>
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>
                        }

                        <RadzenButton Text="Rimuovi"
                                      Style="align-self: center"
                                      Size="ButtonSize.ExtraSmall"
                                      Variant="Variant.Text"
                                      Click=@(() => OnRimuoviClick(vm)) />
                    </div>


                    <DailyRecurrencePicker @key=vm @bind-DailyRecurrence=vm.DailyRecurrence Change=OnRecurrenceChanged />
                </RadzenStack>

            </RadzenFieldset>

        }
    </RadzenStack>
</RadzenStack>

@using IncaTechnologies.Recurrence
@code {

    private abstract class MonthlyViewModel
    {
        public IDaily? DailyRecurrence { get; set; }
    }

    private sealed class DayOfMonthViewModel : MonthlyViewModel
    {
        public int? DayOfMonth { get; set; } = 1;
    }

    private sealed class WeekOfMonthViewModel : MonthlyViewModel
    {
        public string? WeekOfMonth { get; set; } = _weeksOfMonth[0];
        public string? DayOfWeek { get; set; } = _daysOfWeek[0];
    }

    private static readonly string[] _weeksOfMonth = FormatterRecurrent.SettimaneNelMese;
    private static readonly string[] _daysOfWeek = FormatterRecurrent.GiorniDellaSettimana;
    private readonly List<MonthlyViewModel> _viewModels = [];

    [Parameter]
    public IMonthly? MonthlyRecurrence { get; set; }

    [Parameter]
    public EventCallback<IMonthly?> MonthlyRecurrenceChanged { get; set; }

    [Parameter]
    public EventCallback<IMonthly?> Change { get; set; }

    private async Task OnAggiungiGiornoClick()
    {
        _viewModels.Add(new DayOfMonthViewModel());
        await OnRecurrenceChanged();
    }

    private async Task OnAggiungiSettimanaClick()
    {
        _viewModels.Add(new WeekOfMonthViewModel());
        await OnRecurrenceChanged();
    }

    private async Task OnRimuoviClick(MonthlyViewModel definition)
    {
        _viewModels.Remove(definition);
        await OnRecurrenceChanged();
    }

    private async Task OnRecurrenceChanged()
    {
        MonthlyRecurrence = GenerateRecurrence(_viewModels);

        await MonthlyRecurrenceChanged.InvokeAsync(MonthlyRecurrence);
        await Change.InvokeAsync(MonthlyRecurrence);
    }

    private static IMonthly? GenerateRecurrence(IEnumerable<MonthlyViewModel> viewModels)
    {
        if (viewModels.Any() is false) return null;

        var monthly = Occurs.EveryMonth().The(the =>
        {
            foreach (var vm in viewModels)
            {
                var hourly = vm switch
                {
                    DayOfMonthViewModel { DayOfMonth: int d } => the.Day(d),
                    WeekOfMonthViewModel { WeekOfMonth: string w, DayOfWeek: string d } => the.SetDayInMonth(ParseDayInMonth(w), ParseDayOfWeek(d)),
                    _ => throw new Exception()
                };

                hourly.At(at =>
                {
                    vm.DailyRecurrence?.ForEachAt(x =>
                    {
                        at.Hour(x.Hour).Minute(x.Minute).Second(x.Second);
                    });
                });
            }
        });

        return (IMonthly)monthly.GetRoot();
    }

    private static DayInMonth ParseDayInMonth(string x) => x switch
    {
        "Prima" => DayInMonth.First,
        "Seconda" => DayInMonth.Second,
        "Terza" => DayInMonth.Third,
        "Quarta" => DayInMonth.Fourth,
        "Ultima" => DayInMonth.Last,
        _ => throw new ArgumentException($"Impossible to parse day in month '{x}'.", nameof(x))
    };

    private static DayOfWeek ParseDayOfWeek(string x) => x switch
    {
        "Lunedì" => DayOfWeek.Monday,
        "Martedì" => DayOfWeek.Tuesday,
        "Mercoledì" => DayOfWeek.Wednesday,
        "Giovedì" => DayOfWeek.Thursday,
        "Venerdì" => DayOfWeek.Friday,
        "Sabato" => DayOfWeek.Saturday,
        "Domenica" => DayOfWeek.Sunday,
        _ => throw new ArgumentException($"Impossible to parse day of week '{x}'.", nameof(x))
    };
}

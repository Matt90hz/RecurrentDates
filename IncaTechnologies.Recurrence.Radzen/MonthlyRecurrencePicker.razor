<RadzenStack Visible=@Visible>
    <RadzenStack Orientation="Orientation.Horizontal">
        <RadzenButton Text=@SpecifyNumberButtonText Size="ButtonSize.ExtraSmall" Variant="Variant.Text" Disabled=@Disabled Click="OnAggiungiGiornoClick" />
        <RadzenButton Text=@SpecifyDayButtonText Size="ButtonSize.ExtraSmall" Variant="Variant.Text" Disabled=@Disabled Click="OnAggiungiSettimanaClick" />
    </RadzenStack>
    <RadzenStack Gap="0.5rem">
        @foreach (var (i, vm) in _viewModels.Index())
        {
            <RadzenFieldset Style="padding-top: 0.5rem">
                <RadzenStack>
                    <div style="display:flex; gap: 1rem">

                        @if (vm is DayOfMonthViewModel dom)
                        {
                            <RadzenFormField Text=@NumberInputFieldCaption Style="flex-grow: 1">
                                <ChildContent>
                                    <RadzenNumeric Name=@($"nuGiornoNelMese{i}{vm.GetHashCode()}")
                                                   @bind-Value=dom.DayOfMonth
                                                   TValue="int?"
                                                   Min="1"
                                                   Max="31"
                                                   Step="1"
                                                   Disabled=@Disabled
                                                   Change=OnChanged />
                                </ChildContent>
                                <Helper>
                                    <RadzenRequiredValidator Component=@($"nuGiornoNelMese{i}{vm.GetHashCode()}") />
                                </Helper>
                            </RadzenFormField>
                        }
                        else if (vm is DayInMonthViewModel dim)
                        {
                            <RadzenRow Style="flex-grow: 1">
                                <RadzenColumn>
                                        <RadzenFormField class="rz-w-100" Text=@DropDownDayInMonthCaption>
                                        <ChildContent>
                                            <RadzenDropDown Name=@($"ddSettimanaNelMese{i}{vm.GetHashCode()}")
                                                            @bind-Value=dim.DayInMonth
                                                            ValueProperty=@nameof(DayInMonthOption.Value)
                                                            TextProperty=@nameof(DayInMonthOption.Text)
                                                            Data=_daysInMonth
                                                            Disabled=@Disabled
                                                            Change=OnChanged />
                                        </ChildContent>
                                        <Helper>
                                            <RadzenRequiredValidator Component=@($"ddSettimanaNelMese{i}{vm.GetHashCode()}") />
                                        </Helper>
                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn>
                                    <RadzenFormField class="rz-w-100" Text=@DropDownDayOfWeekCaption>
                                        <ChildContent>
                                            <RadzenDropDown Name=@($"ddGiornoDellaSettimana{i}{vm.GetHashCode()}")
                                                            @bind-Value=dim.DayOfWeek
                                                            ValueProperty=@nameof(DayOfWeekOption.Value)
                                                            TextProperty=@nameof(DayOfWeekOption.Text)
                                                            Data=_daysOfWeek
                                                            Disabled=@Disabled
                                                            Change=OnChanged />
                                        </ChildContent>
                                        <Helper>
                                            <RadzenRequiredValidator Component=@($"ddGiornoDellaSettimana{i}{vm.GetHashCode()}") />
                                        </Helper>
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>
                        }

                        <RadzenButton Text=@RemoveButtonText
                                      Style="align-self: center"
                                      Size="ButtonSize.ExtraSmall"
                                      Variant="Variant.Text"
                                      Disabled=@Disabled
                                      Click=@(() => OnRimuoviClick(vm)) />
                    </div>


                    <DailyRecurrencePicker @key=vm @bind-Value=vm.DailyRecurrence Disabled=@Disabled Change=OnChanged />
                </RadzenStack>
            </RadzenFieldset>
        }
    </RadzenStack>
</RadzenStack>

@inherits FormComponent<IMonthly?>
@using IncaTechnologies.Recurrence
@code {

    /// <summary>Gets or sets the text displayed on the button for adding a day-of-month rule.</summary>
    /// <remarks>When no value is provided, the localized text from <see cref="RecurrenceStrings"/> is used.</remarks>
    [Parameter]
    public string? SpecifyNumberButtonText { get => field ?? Localize(nameof(RecurrenceStrings.Inca_SpecifyNumber)); set; }

    /// <summary>Gets or sets the text displayed on the button for adding an ordinal weekday rule.</summary>
    /// <remarks>When no value is provided, the localized text from <see cref="RecurrenceStrings"/> is used.</remarks>
    [Parameter]
    public string? SpecifyDayButtonText { get => field ?? Localize(nameof(RecurrenceStrings.Inca_SpecifyDay)); set; }

    /// <summary>Gets or sets the caption displayed for the day-of-month input.</summary>
    /// <remarks>When no value is provided, the localized text from <see cref="RecurrenceStrings"/> is used.</remarks>
    [Parameter]
    public string? NumberInputFieldCaption { get => field ?? Localize(nameof(RecurrenceStrings.Inca_Number)); set; }

    /// <summary>Gets or sets the caption displayed for the ordinal day selector.</summary>
    /// <remarks>When no value is provided, the localized text from <see cref="RecurrenceStrings"/> is used.</remarks>
    [Parameter]
    public string? DropDownDayInMonthCaption { get => field ?? Localize(nameof(RecurrenceStrings.Inca_The)); set; }

    /// <summary>Gets or sets the caption displayed for the day-of-week selector.</summary>
    /// <remarks>When no value is provided, the localized text from <see cref="RecurrenceStrings"/> is used.</remarks>
    [Parameter]
    public string? DropDownDayOfWeekCaption { get => field ?? Localize(nameof(RecurrenceStrings.Inca_Day)); set; }

    /// <summary>Gets or sets the text displayed on the rule removal button.</summary>
    /// <remarks>When no value is provided, the localized text from <see cref="RecurrenceStrings"/> is used.</remarks>
    [Parameter]
    public string? RemoveButtonText { get => field ?? Localize(nameof(RecurrenceStrings.Inca_Remove)); set; }

    /// <summary>Gets or sets the display text for the first ordinal.</summary>
    /// <remarks>When no value is provided, the localized text from <see cref="RecurrenceStrings"/> is used.</remarks>
    [Parameter]
    public string? FirstText { get => field ?? Localize(nameof(RecurrenceStrings.Inca_Ordinal_First)); set; }

    /// <summary>Gets or sets the display text for the second ordinal.</summary>
    /// <remarks>When no value is provided, the localized text from <see cref="RecurrenceStrings"/> is used.</remarks>
    [Parameter]
    public string? SecondText { get => field ?? Localize(nameof(RecurrenceStrings.Inca_Ordinal_Second)); set; }

    /// <summary>Gets or sets the display text for the third ordinal.</summary>
    /// <remarks>When no value is provided, the localized text from <see cref="RecurrenceStrings"/> is used.</remarks>
    [Parameter]
    public string? ThirdText { get => field ?? Localize(nameof(RecurrenceStrings.Inca_Ordinal_Third)); set; }

    /// <summary>Gets or sets the display text for the fourth ordinal.</summary>
    /// <remarks>When no value is provided, the localized text from <see cref="RecurrenceStrings"/> is used.</remarks>
    [Parameter]
    public string? FourthText { get => field ?? Localize(nameof(RecurrenceStrings.Inca_Ordinal_Fourth)); set; }

    /// <summary>Gets or sets the display text for the last ordinal.</summary>
    /// <remarks>When no value is provided, the localized text from <see cref="RecurrenceStrings"/> is used.</remarks>
    [Parameter]
    public string? LastText { get => field ?? Localize(nameof(RecurrenceStrings.Inca_Ordinal_Last)); set; }

    /// <summary>Gets or sets the display text for Monday.</summary>
    /// <remarks>When no value is provided, the localized text from <see cref="RecurrenceStrings"/> is used.</remarks>
    [Parameter]
    public string? MondayText { get => field ?? Localize(nameof(RecurrenceStrings.Inca_DayOfWeek_Monday)); set; }

    /// <summary>Gets or sets the display text for Tuesday.</summary>
    /// <remarks>When no value is provided, the localized text from <see cref="RecurrenceStrings"/> is used.</remarks>
    [Parameter]
    public string? TuesdayText { get => field ?? Localize(nameof(RecurrenceStrings.Inca_DayOfWeek_Tuesday)); set; }

    /// <summary>Gets or sets the display text for Wednesday.</summary>
    /// <remarks>When no value is provided, the localized text from <see cref="RecurrenceStrings"/> is used.</remarks>
    [Parameter]
    public string? WednesdayText { get => field ?? Localize(nameof(RecurrenceStrings.Inca_DayOfWeek_Wednesday)); set; }

    /// <summary>Gets or sets the display text for Thursday.</summary>
    /// <remarks>When no value is provided, the localized text from <see cref="RecurrenceStrings"/> is used.</remarks>
    [Parameter]
    public string? ThursdayText { get => field ?? Localize(nameof(RecurrenceStrings.Inca_DayOfWeek_Thursday)); set; }

    /// <summary>Gets or sets the display text for Friday.</summary>
    /// <remarks>When no value is provided, the localized text from <see cref="RecurrenceStrings"/> is used.</remarks>
    [Parameter]
    public string? FridayText { get => field ?? Localize(nameof(RecurrenceStrings.Inca_DayOfWeek_Friday)); set; }

    /// <summary>Gets or sets the display text for Saturday.</summary>
    /// <remarks>When no value is provided, the localized text from <see cref="RecurrenceStrings"/> is used.</remarks>
    [Parameter]
    public string? SaturdayText { get => field ?? Localize(nameof(RecurrenceStrings.Inca_DayOfWeek_Saturday)); set; }

    /// <summary>Gets or sets the display text for Sunday.</summary>
    /// <remarks>When no value is provided, the localized text from <see cref="RecurrenceStrings"/> is used.</remarks>
    [Parameter]
    public string? SundayText { get => field ?? Localize(nameof(RecurrenceStrings.Inca_DayOfWeek_Sunday)); set; }


    private sealed class DayInMonthOption(DayInMonth value, string text)
    {
        public DayInMonth Value { get; } = value;
        public string Text { get; } = text;
    }

    private sealed class DayOfWeekOption(DayOfWeek value, string text)
    {
        public DayOfWeek Value { get; } = value;
        public string Text { get; } = text;
    }

    private abstract class MonthlyViewModel
    {
        public IDaily? DailyRecurrence { get; set; }
    }

    private sealed class DayOfMonthViewModel : MonthlyViewModel
    {
        public int? DayOfMonth { get; set; }
    }

    private sealed class DayInMonthViewModel : MonthlyViewModel
    {
        public DayInMonth? DayInMonth { get; set; }
        public DayOfWeek? DayOfWeek { get; set; }
    }

    private IEnumerable<DayInMonthOption> _daysInMonth = [];
    private IEnumerable<DayOfWeekOption> _daysOfWeek = [];
    private readonly List<MonthlyViewModel> _viewModels = [];
    private IMonthly? _preValue;

    protected override void OnInitialized()
    {
        _daysInMonth = [.. Enum.GetValues<DayInMonth>().Select(x => new DayInMonthOption(x, LocalizeDayInMonth(x)))];
        _daysOfWeek = [.. Enum.GetValues<DayOfWeek>().Select(x => new DayOfWeekOption(x, LocalizeDayOfWeek(x)))];
    }

    protected override void OnParametersSet()
    {
        if (Value is not IMonthly monthly || monthly.ValueEquals(_preValue)) return;

        _viewModels.Clear();

        monthly.ForEachThe(
            x => _viewModels.Add(new DayOfMonthViewModel
            {
                DayOfMonth = x.DayOfMonth,
                DailyRecurrence = x.Then
            }),
            x => _viewModels.Add(new DayInMonthViewModel
            {
                DayInMonth = x.DayInMonth,
                DayOfWeek = x.DayOfWeek,
                DailyRecurrence = x.Then
            }));

        _preValue = monthly;
    }

    private string LocalizeDayInMonth(DayInMonth day) => day switch
    {
        DayInMonth.First => FirstText ?? "First",
        DayInMonth.Second => SecondText ?? "Second",
        DayInMonth.Third => ThirdText ?? "Third",
        DayInMonth.Fourth => FourthText ?? "Fourth",
        DayInMonth.Last => LastText ?? "Last",
        _ => throw new ArgumentOutOfRangeException(nameof(day), day, "The day must be a supported ordinal.")
    };

    private string LocalizeDayOfWeek(DayOfWeek day) => day switch
    {
        DayOfWeek.Monday => MondayText ?? "Monday",
        DayOfWeek.Tuesday => TuesdayText ?? "Tuesday",
        DayOfWeek.Wednesday => WednesdayText ?? "Wednesday",
        DayOfWeek.Thursday => ThursdayText ?? "Thursday",
        DayOfWeek.Friday => FridayText ?? "Friday",
        DayOfWeek.Saturday => SaturdayText ?? "Saturday",
        DayOfWeek.Sunday => SundayText ?? "Sunday",
        _ => throw new ArgumentOutOfRangeException(nameof(day), day, "The day must be between Sunday and Saturday.")
    };

    private async Task OnAggiungiGiornoClick()
    {
        _viewModels.Add(new DayOfMonthViewModel());
    }

    private async Task OnAggiungiSettimanaClick()
    {
        _viewModels.Add(new DayInMonthViewModel());
    }

    private async Task OnRimuoviClick(MonthlyViewModel definition)
    {
        _viewModels.Remove(definition);
        await OnChanged();
    }

    private async Task OnChanged()
    {
        Value = GenerateRecurrence(_viewModels);

        await ValueChanged.InvokeAsync(Value);
        await Change.InvokeAsync(Value);
    }

    private static IMonthly? GenerateRecurrence(IEnumerable<MonthlyViewModel> viewModels)
    {
        if (viewModels.Any() is false
            || viewModels.Any(x => x 
                is DayOfMonthViewModel { DayOfMonth: null } 
                or DayInMonthViewModel { DayInMonth: null } 
                or DayInMonthViewModel { DayOfWeek: null })) return null;

        var monthly = Occurs.EveryMonth().The(the =>
        {
            foreach (var vm in viewModels)
            {
                var hourly = vm switch
                {
                    DayOfMonthViewModel { DayOfMonth: int d } => the.Day(d),
                    DayInMonthViewModel { DayInMonth: DayInMonth w, DayOfWeek: DayOfWeek d } => the.SetDayInMonth(w, d),
                    _ => throw new Exception("Should be impossible to reach.")
                };

                hourly.At(at =>
                {
                    vm.DailyRecurrence?.ForEachAt(x =>
                    {
                        at.Hour(x.Hour).Minute(x.Minute).Second(x.Second);
                    });
                });
            }
        });

        return (IMonthly)monthly.GetRoot();
    }

}

<RadzenStack Visible=@Visible>
    <RadzenStack Orientation="Orientation.Horizontal">
        <RadzenButton Text="Specifica numero" Size="ButtonSize.ExtraSmall" Variant="Variant.Text" Disabled=@Disabled Click="OnAggiungiGiornoClick" />
        <RadzenButton Text="Specifica giorno" Size="ButtonSize.ExtraSmall" Variant="Variant.Text" Disabled=@Disabled Click="OnAggiungiSettimanaClick" />
    </RadzenStack>
    <RadzenStack Gap="0.5rem">
        @foreach (var (i, vm) in _viewModels.Index())
        {
            <RadzenFieldset Style="padding-top: 0.5rem">
                <RadzenStack>
                    <div style="display:flex; gap: 1rem">

                        @if (vm is DayOfMonthViewModel dom)
                        {
                            <RadzenFormField Text="Numero" Style="flex-grow: 1">
                                <ChildContent>
                                    <RadzenNumeric Name=@($"nuGiornoNelMese{i}{vm.GetHashCode()}")
                                                   @bind-Value=dom.DayOfMonth
                                                   TValue="int?"
                                                   Min="1"
                                                   Max="31"
                                                   Step="1"
                                                   Disabled=@Disabled
                                                   Change=OnChanged />
                                </ChildContent>
                                <Helper>
                                    <RadzenRequiredValidator Component=@($"nuGiornoNelMese{i}{vm.GetHashCode()}") />
                                </Helper>
                            </RadzenFormField>
                        }
                        else if (vm is DayInMonthViewModel dim)
                        {
                            <RadzenRow Style="flex-grow: 1">
                                <RadzenColumn>
                                    <RadzenFormField class="rz-w-100" Text="Nel">
                                        <ChildContent>
                                            <RadzenDropDown Name=@($"ddSettimanaNelMese{i}{vm.GetHashCode()}")
                                                            @bind-Value=dim.DayInMonth
                                                            Data=_daysInMonth
                                                            Disabled=@Disabled
                                                            Change=OnChanged />
                                        </ChildContent>
                                        <Helper>
                                            <RadzenRequiredValidator Component=@($"ddSettimanaNelMese{i}{vm.GetHashCode()}") />
                                        </Helper>
                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn>
                                    <RadzenFormField class="rz-w-100" Text="Giorno">
                                        <ChildContent>
                                            <RadzenDropDown Name=@($"ddGiornoDellaSettimana{i}{vm.GetHashCode()}")
                                                            @bind-Value=dim.DayOfWeek
                                                            Data=_daysOfWeek
                                                            Disabled=@Disabled
                                                            Change=OnChanged />
                                        </ChildContent>
                                        <Helper>
                                            <RadzenRequiredValidator Component=@($"ddGiornoDellaSettimana{i}{vm.GetHashCode()}") />
                                        </Helper>
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>
                        }

                        <RadzenButton Text="Rimuovi"
                                      Style="align-self: center"
                                      Size="ButtonSize.ExtraSmall"
                                      Variant="Variant.Text"
                                      Disabled=@Disabled
                                      Click=@(() => OnRimuoviClick(vm)) />
                    </div>


                    <DailyRecurrencePicker @key=vm @bind-Value=vm.DailyRecurrence Disabled=@Disabled Change=OnChanged />
                </RadzenStack>
            </RadzenFieldset>
        }
    </RadzenStack>
</RadzenStack>

@inherits FormComponent<IMonthly?>
@using IncaTechnologies.Recurrence
@code {

    private abstract class MonthlyViewModel
    {
        public IDaily? DailyRecurrence { get; set; }
    }

    private sealed class DayOfMonthViewModel : MonthlyViewModel
    {
        public int? DayOfMonth { get; set; }
    }

    private sealed class DayInMonthViewModel : MonthlyViewModel
    {
        public string? DayInMonth { get; set; } 
        public string? DayOfWeek { get; set; }
    }

    private static readonly string[] _daysInMonth = [.. Enum.GetValues<DayInMonth>().Select(FormatterRecurrent.ToFriendlyString)];
    private static readonly string[] _daysOfWeek = [.. Enum.GetValues<DayOfWeek>().Select(FormatterRecurrent.ToFriendlyString)];
    private readonly List<MonthlyViewModel> _viewModels = [];

    private async Task OnAggiungiGiornoClick()
    {
        _viewModels.Add(new DayOfMonthViewModel());
        await OnChanged();
    }

    private async Task OnAggiungiSettimanaClick()
    {
        _viewModels.Add(new DayInMonthViewModel());
        await OnChanged();
    }

    private async Task OnRimuoviClick(MonthlyViewModel definition)
    {
        _viewModels.Remove(definition);
        await OnChanged();
    }

    private async Task OnChanged()
    {
        Value = GenerateRecurrence(_viewModels);

        await ValueChanged.InvokeAsync(Value);
        await Change.InvokeAsync(Value);
    }

    private static IMonthly? GenerateRecurrence(IEnumerable<MonthlyViewModel> viewModels)
    {
        if (viewModels.Any() is false
            || viewModels.Any(x => x 
                is DayOfMonthViewModel { DayOfMonth: null } 
                or DayInMonthViewModel { DayInMonth: null } 
                or DayInMonthViewModel { DayOfWeek: null })) return null;

        var monthly = Occurs.EveryMonth().The(the =>
        {
            foreach (var vm in viewModels)
            {
                var hourly = vm switch
                {
                    DayOfMonthViewModel { DayOfMonth: int d } => the.Day(d),
                    DayInMonthViewModel { DayInMonth: string w, DayOfWeek: string d } => the.SetDayInMonth(ParseDayInMonth(w), ParseDayOfWeek(d)),
                    _ => throw new Exception("Should be impossible to reach.")
                };

                hourly.At(at =>
                {
                    vm.DailyRecurrence?.ForEachAt(x =>
                    {
                        at.Hour(x.Hour).Minute(x.Minute).Second(x.Second);
                    });
                });
            }
        });

        return (IMonthly)monthly.GetRoot();
    }

    private static DayInMonth ParseDayInMonth(string x) => x switch
    {
        "Primo" => DayInMonth.First,
        "Secondo" => DayInMonth.Second,
        "Terzo" => DayInMonth.Third,
        "Quarto" => DayInMonth.Fourth,
        "Ultimo" => DayInMonth.Last,
        _ => throw new ArgumentException($"Impossible to parse day in month '{x}'.", nameof(x))
    };

    private static DayOfWeek ParseDayOfWeek(string x) => x switch
    {
        "Lunedì" => DayOfWeek.Monday,
        "Martedì" => DayOfWeek.Tuesday,
        "Mercoledì" => DayOfWeek.Wednesday,
        "Giovedì" => DayOfWeek.Thursday,
        "Venerdì" => DayOfWeek.Friday,
        "Sabato" => DayOfWeek.Saturday,
        "Domenica" => DayOfWeek.Sunday,
        _ => throw new ArgumentException($"Impossible to parse day of week '{x}'.", nameof(x))
    };
}

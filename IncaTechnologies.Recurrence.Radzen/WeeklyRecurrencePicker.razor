<RadzenStack Visible=@Visible>
    <RadzenFormField Text=@DropDownDayOfWeekCaption Style="width: 100%">
        <ChildContent>
            <RadzenDropDown Name="ddGiorno"
                            @bind-Value=_selectedDays
                            TextProperty=@(nameof(DayViewModel.Text))
                            Data=_days
                            Multiple=true
                            AllowSelectAll=false
                            Disabled=@Disabled
                            Change=OnChanged>
            </RadzenDropDown>
        </ChildContent>
        <Helper>
            <RadzenRequiredValidator Component="ddGiorno" />
        </Helper>
    </RadzenFormField>

    @foreach (var day in _selectedDays)
    {
        <RadzenFieldset Text=@day.Text>
            <DailyRecurrencePicker @key=day.Text @bind-Value=day.Daily Disabled=@Disabled Change=OnChanged />
        </RadzenFieldset>
    }
</RadzenStack>

@inherits FormComponent<IWeekly?>
@inject ILocalizer _localizer;
@using IncaTechnologies.Recurrence
@code {
    /// <summary>Gets or sets the caption displayed above the day-of-week selector.</summary>
    /// <remarks>When no value is provided, the localized text from <see cref="RecurrenceStrings"/> is used.</remarks>
    [Parameter]
    public string? DropDownDayOfWeekCaption { get => field ?? Localize(nameof(RecurrenceStrings.Inca_Day)); set; }

    /// <summary>Gets or sets the display text for Monday.</summary>
    /// <remarks>When no value is provided, the localized text from <see cref="RecurrenceStrings"/> is used.</remarks>
    [Parameter]
    public string? MondayText { get => field ?? Localize(nameof(RecurrenceStrings.Inca_DayOfWeek_Monday)); set; }

    /// <summary>Gets or sets the display text for Tuesday.</summary>
    /// <remarks>When no value is provided, the localized text from <see cref="RecurrenceStrings"/> is used.</remarks>
    [Parameter]
    public string? TuesdayText { get => field ?? Localize(nameof(RecurrenceStrings.Inca_DayOfWeek_Tuesday)); set; }

    /// <summary>Gets or sets the display text for Wednesday.</summary>
    /// <remarks>When no value is provided, the localized text from <see cref="RecurrenceStrings"/> is used.</remarks>
    [Parameter]
    public string? WednesdayText { get => field ?? Localize(nameof(RecurrenceStrings.Inca_DayOfWeek_Wednesday)); set; }

    /// <summary>Gets or sets the display text for Thursday.</summary>
    /// <remarks>When no value is provided, the localized text from <see cref="RecurrenceStrings"/> is used.</remarks>
    [Parameter]
    public string? ThursdayText { get => field ?? Localize(nameof(RecurrenceStrings.Inca_DayOfWeek_Thursday)); set; }

    /// <summary>Gets or sets the display text for Friday.</summary>
    /// <remarks>When no value is provided, the localized text from <see cref="RecurrenceStrings"/> is used.</remarks>
    [Parameter]
    public string? FridayText { get => field ?? Localize(nameof(RecurrenceStrings.Inca_DayOfWeek_Friday)); set; }

    /// <summary>Gets or sets the display text for Saturday.</summary>
    /// <remarks>When no value is provided, the localized text from <see cref="RecurrenceStrings"/> is used.</remarks>
    [Parameter]
    public string? SaturdayText { get => field ?? Localize(nameof(RecurrenceStrings.Inca_DayOfWeek_Saturday)); set; }

    /// <summary>Gets or sets the display text for Sunday.</summary>
    /// <remarks>When no value is provided, the localized text from <see cref="RecurrenceStrings"/> is used.</remarks>
    [Parameter]
    public string? SundayText { get => field ?? Localize(nameof(RecurrenceStrings.Inca_DayOfWeek_Sunday)); set; }

    private sealed class DayViewModel(DayOfWeek dayOfWeek, string text)
    {
        public string Text { get; } = text;
        public DayOfWeek Day { get; } = dayOfWeek;
        public IDaily? Daily { get; set; }
    }

    private IEnumerable<DayViewModel> _days = [];
    private IEnumerable<DayViewModel> _selectedDays = [];

    protected override void OnInitialized()
    {
        _days = [.. Enum.GetValues<DayOfWeek>().Select(x => new DayViewModel(x, LocalizeDay(x)))];
    }

    private bool _initialized;

    protected override void OnParametersSet()
    {
        if (Value is not IWeekly weekly || _initialized) return;

        _selectedDays = [.. weekly.SelectOn(on =>
        {
            var day = _days.First(day => day.Day == on.DayOfWeek);
            day.Daily = on.Then;
            return day;
        })];

        _initialized = true;
    }

    private string LocalizeDay(DayOfWeek day) => day switch
    {
        DayOfWeek.Monday => MondayText ?? "Monday",
        DayOfWeek.Tuesday => TuesdayText ?? "Tuesday",
        DayOfWeek.Wednesday => WednesdayText ?? "Wednesday",
        DayOfWeek.Thursday => ThursdayText ?? "Thursday",
        DayOfWeek.Friday => FridayText ?? "Friday",
        DayOfWeek.Saturday => SaturdayText ?? "Saturday",
        DayOfWeek.Sunday => SundayText ?? "Sunday",
        _ => throw new ArgumentOutOfRangeException(nameof(day), day, "The day must be between Sunday and Saturday.")
    };

    private async Task OnChanged()
    {
        Value = GenerateRecurrence(_selectedDays);

        await ValueChanged.InvokeAsync(Value);
        await Change.InvokeAsync(Value);
    }

    private static IWeekly? GenerateRecurrence(IEnumerable<DayViewModel> viewModels)
    {
        if (viewModels.Any() is false) return null;

        var weekly = Occurs.EveryWeek().On(on =>
        {
            foreach (var vm in viewModels)
            {
                on.SetDayOfWeek(vm.Day).At(at =>
                {
                    vm.Daily.ForEachAt(x =>
                    {
                        at.Hour(x.Hour).Minute(x.Minute).Second(x.Second);
                    });
                });
            }
        });

        return (IWeekly)weekly.GetRoot();
    }
}

<RadzenFormField Text="Giorno" Style="width: 100%">
    <ChildContent>
        <RadzenDropDown Name="ddGiorno"
                        @bind-Value=_selectedDays
                        TextProperty=@(nameof(DayViewModel.Text))
                        Data=_days
                        Multiple="true"
                        Change=OnRecurrenceChanged>
        </RadzenDropDown>
    </ChildContent>
    <Helper>
        <RadzenRequiredValidator Component="ddGiorno" />
    </Helper>
</RadzenFormField>

@foreach (var day in _selectedDays)
{
    <RadzenFieldset Text=@day.Text AllowCollapse="true">
        <DailyRecurrencePicker @key=day.Text @bind-DailyRecurrence=day.Daily Change=OnRecurrenceChanged />
    </RadzenFieldset>
}

@using IncaTechnologies.Recurrence
@code {

    private sealed class DayViewModel(DayOfWeek dayOfWeek)
    {
        public string Text => Day.ToFriendlyString();
        public DayOfWeek Day { get; } = dayOfWeek;
        public IDaily? Daily { get; set; }
    }

    private IEnumerable<DayViewModel> _days = [.. Enum.GetValues<DayOfWeek>().Select(x => new DayViewModel(x))];
    private IEnumerable<DayViewModel> _selectedDays = [];

    [Parameter]
    public IWeekly WeeklyRecurrence { get; set; } = null!;

    [Parameter]
    public EventCallback<IWeekly> WeeklyRecurrenceChanged { get; set; }

    [Parameter]
    public EventCallback<IWeekly> Change { get; set; }

    private async Task OnRecurrenceChanged()
    {
        WeeklyRecurrence = GenerateRecurrence(_selectedDays);

        await WeeklyRecurrenceChanged.InvokeAsync(WeeklyRecurrence);
        await Change.InvokeAsync(WeeklyRecurrence);
    }

    private static IWeekly GenerateRecurrence(IEnumerable<DayViewModel> viewModels)
    {
        var weekly = Occurs.EveryWeek().On(on =>
        {
            foreach (var vm in viewModels)
            {
                on.SetDayOfWeek(vm.Day).At(at =>
                {
                    vm.Daily.ForEachAt(x =>
                    {
                        at.Hour(x.Hour).Minute(x.Minute).Second(x.Second);
                    });
                });
            }
        });

        return (IWeekly)weekly.GetRoot();
    }
}

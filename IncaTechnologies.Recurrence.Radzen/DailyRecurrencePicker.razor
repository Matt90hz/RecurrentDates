
    <RadzenStack Orientation=Orientation.Horizontal>
        <RadzenButton class="rz-align-left" Text="Specifica orario" Size="ButtonSize.ExtraSmall" Variant=Variant.Text Click=OnAggiungiClick />
    </RadzenStack>
    <RadzenStack>
        @foreach (var (i, x) in _times.Index())
        {
            <div style="display: flex; gap: 1rem">
                <RadzenFormField Style="flex-grow: 1" Text="Alle">
                    <ChildContent>
                        <RadzenDatePicker Name=@(i + "dpTime") @bind-Value=x.Time TimeOnly=true Change=OnDatePickerChange />
                    </ChildContent>
                    <Helper>
                        <RadzenRequiredValidator Component=@(i + "dpTime") />
                    </Helper>
                </RadzenFormField>
                <RadzenButton Style="align-self: center" Text="Rimuovi" Size="ButtonSize.ExtraSmall" Variant=Variant.Text Disabled=@(_times.Count is 1) Click=@(() => OnRimuoviClick(x)) />
            </div>
        }
    </RadzenStack>

@code {

    private sealed class TimeViewModel
    {
        public TimeOnly? Time { get; set; }
    }

    private readonly List<TimeViewModel> _times = [new TimeViewModel()];

    [Parameter]
    public IDaily DailyRecurrence { get; set; } = null!;

    [Parameter]
    public EventCallback<IDaily> DailyRecurrenceChanged { get; set; }

    [Parameter]
    public EventCallback<IDaily> Change { get; set; }


    private void OnAggiungiClick()
    {
        _times.Add(new());
    }

    private async Task OnDatePickerChange()
    {
        DailyRecurrence = GenerateRecurrence(_times);

        await DailyRecurrenceChanged.InvokeAsync(DailyRecurrence);
        await Change.InvokeAsync(DailyRecurrence);
    }

    private async Task OnRimuoviClick(TimeViewModel viewModel)
    {
        if (_times.Count is 1) return;

        _times.Remove(viewModel);
        DailyRecurrence = GenerateRecurrence(_times);

        await DailyRecurrenceChanged.InvokeAsync(DailyRecurrence);
        await Change.InvokeAsync(DailyRecurrence);
    }

    private static IDaily GenerateRecurrence(IEnumerable<TimeViewModel> viewModels)
    {
        var daily = Occurs.EveryDay().At(x =>
        {
            foreach (var vm in viewModels)
            {
                if (vm.Time is not { Hour: int h, Minute: int m, Second: int s }) continue;

                x.Hour(h).Minute(m).Second(s);
            }
        });

        return (IDaily)daily.GetRoot();
    }
}
<RadzenStack Visible=@Visible Gap="0.15rem">
    <RadzenStack Orientation=Orientation.Horizontal>
        <RadzenButton Text="Specifica orario" Size="ButtonSize.ExtraSmall" Variant=Variant.Text Disabled=@Disabled Click=OnAggiungiClick />
    </RadzenStack>
    <RadzenStack Gap="0.15rem">
        @foreach (var (i, x) in _times.Index())
        {
            <div style="display: flex; gap: 1rem">
                <RadzenFormField Style="flex-grow: 1" Text="Alle">
                    <ChildContent>
                        <RadzenDatePicker Name=@($"dpTime{i}{x.GetHashCode()}") @bind-Value=x.Time TimeOnly=true Disabled=@Disabled Change=OnDatePickerChange />
                    </ChildContent>
                    <Helper>
                        <RadzenRequiredValidator Component=@($"dpTime{i}{x.GetHashCode()}") />
                    </Helper>
                </RadzenFormField>
                <RadzenButton Style="align-self: center" Text="Rimuovi" Size="ButtonSize.ExtraSmall" Variant=Variant.Text Disabled=@Disabled Click=@(() => OnRimuoviClick(x)) />
            </div>
        }
    </RadzenStack>
</RadzenStack>

@inherits FormComponent<IDaily?>
@using IncaTechnologies.Recurrence
@code {

    private sealed class TimeViewModel
    {
        public TimeOnly? Time { get; set; }
    }

    private readonly List<TimeViewModel> _times = [];

    private void OnAggiungiClick()
    {
        _times.Add(new());
    }

    private async Task OnDatePickerChange()
    {
        Value = GenerateRecurrence(_times);

        await ValueChanged.InvokeAsync(Value);
        await Change.InvokeAsync(Value);
    }

    private async Task OnRimuoviClick(TimeViewModel viewModel)
    {
        _times.Remove(viewModel);
        Value = GenerateRecurrence(_times);

        await ValueChanged.InvokeAsync(Value);
        await Change.InvokeAsync(Value);
    }

    private static IDaily? GenerateRecurrence(IEnumerable<TimeViewModel> viewModels)
    {
        if (viewModels.Any() is false) return null; 

        var daily = Occurs.EveryDay().At(x =>
        {
            foreach (var vm in viewModels)
            {
                if (vm.Time is not { Hour: int h, Minute: int m, Second: int s }) continue;

                x.Hour(h).Minute(m).Second(s);
            }
        });

        return (IDaily)daily.GetRoot();
    }
}
<RadzenStack Visible=@Visible>
    <RadzenFormField Text=@EveryText>
        <RadzenDropDown Disabled=@Disabled
                        @bind-Value=_selectedFrequency
                        TextProperty=@nameof(FrequencyViewModel.Text)
                        Data=_frequencies
                        Change="@(x => OnChanged(null))" />
    </RadzenFormField>

    @if (_selectedFrequency?.Frequency is Frequency.Day)
    {
        <DailyRecurrencePicker Value=@(Value as IDaily) Disabled=@Disabled Change=OnChanged />
    }
    else if (_selectedFrequency?.Frequency is Frequency.Week)
    {
        <WeeklyRecurrencePicker Value=@(Value as IWeekly) Disabled=@Disabled Change=OnChanged />
    }
    else if (_selectedFrequency?.Frequency is Frequency.Month)
    {
        <MonthlyRecurrencePicker Value=@(Value as IMonthly) Disabled=@Disabled Change=OnChanged />
    }
    else if (_selectedFrequency?.Frequency is Frequency.Year)
    {
        <YearlyRecurrencePicker Value=@(Value as IYearly) Disabled=@Disabled Change=OnChanged />
    }
</RadzenStack>

@inherits FormComponent<IRecurrent?>
@inject ILocalizer _localizer;
@using IncaTechnologies.Recurrence
@code
{
    /// <summary>Gets or sets the label displayed above the recurrence frequency selector.</summary>
    /// <remarks>When no value is provided, the localized <c>Inca_Every</c> string is used.</remarks>
    [Parameter]
    public string? EveryText { get => field ?? Localize(nameof(RecurrenceStrings.Inca_Every)); set; }

    /// <summary>Gets or sets the display text for the daily recurrence option.</summary>
    /// <remarks>When no value is provided, the localized <c>Inca_Day</c> string is used.</remarks>
    [Parameter]
    public string? DayText { get => field ?? Localize(nameof(RecurrenceStrings.Inca_Day)); set; }

    /// <summary>Gets or sets the display text for the weekly recurrence option.</summary>
    /// <remarks>When no value is provided, the localized <c>Inca_Week</c> string is used.</remarks>
    [Parameter]
    public string? WeekText { get => field ?? Localize(nameof(RecurrenceStrings.Inca_Week)); set; }

    /// <summary>Gets or sets the display text for the monthly recurrence option.</summary>
    /// <remarks>When no value is provided, the localized <c>Inca_Month</c> string is used.</remarks>
    [Parameter]
    public string? MonthText { get => field ?? Localize(nameof(RecurrenceStrings.Inca_Month)); set; }

    /// <summary>Gets or sets the display text for the yearly recurrence option.</summary>
    /// <remarks>When no value is provided, the localized <c>Inca_Year</c> string is used.</remarks>
    [Parameter]
    public string? YearText { get => field ?? Localize(nameof(RecurrenceStrings.Inca_Year)); set; }


    private enum Frequency
    {

        Day,
        Week,
        Month,
        Year
    }


    private sealed class FrequencyViewModel(Frequency frequency, string text)
    {
        public Frequency Frequency { get; } = frequency;
        public string Text { get; } = text;
    }

    private IEnumerable<FrequencyViewModel> _frequencies = [];
    private FrequencyViewModel? _selectedFrequency;
    private bool _initialized = false;

    protected override void OnInitialized()
    {
        _frequencies =
        [
            new(Frequency.Day, DayText ?? "Day"),
            new(Frequency.Week, WeekText ?? "Week"),
            new(Frequency.Month, MonthText ?? "Month"),
            new(Frequency.Year, YearText ?? "Year")
        ];
    }

    protected override void OnParametersSet()
    {
        if (Value is not IRecurrent recurrent || _initialized) return;

        _selectedFrequency = recurrent.GetRoot() switch
        {
            IDaily d => _frequencies.First(x => x.Frequency is Frequency.Day),
            IWeekly d => _frequencies.First(x => x.Frequency is Frequency.Week),
            IMonthly d => _frequencies.First(x => x.Frequency is Frequency.Month),
            IYearly d => _frequencies.First(x => x.Frequency is Frequency.Year),
            _ => null
        };

        _initialized = true;
    }

    private async Task OnChanged(IRecurrent? recurrence)
    {
        Value = recurrence;

        await ValueChanged.InvokeAsync(Value);
        await Change.InvokeAsync(Value);
    }
}
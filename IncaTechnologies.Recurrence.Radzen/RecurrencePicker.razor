<RadzenStack>
    <RadzenFormField Text="Ogni">
        <ChildContent>
            <RadzenDropDown Name="ddOgni" @bind-Value=_ogni Data=_ogniOpzioni/>
        </ChildContent>
        <Helper>
            <RadzenRequiredValidator Component="ddOgni" />
        </Helper>
    </RadzenFormField>

    @if (_ogni is "Giorno")
    {
        <DailyRecurrencePicker Change=OnRecurrenceChanged />
    }
    else if (_ogni is "Settimana")
    {
        <WeeklyRecurrencePicker Change=OnRecurrenceChanged />
    }
    else if (_ogni is "Mese")
    {
        <MonthlyRecurrencePicker Change=OnRecurrenceChanged />
    }
    else if (_ogni is "Anno")
    {
        <YearlyRecurrencePicker Change=OnRecurrenceChanged />
    }
</RadzenStack>

@using IncaTechnologies.Recurrence
@code {

    [Parameter]
    public IRecurrent? Recurrent { get; set; }

    [Parameter]
    public EventCallback<IRecurrent?> RecurrentChanged { get; set; }

    public EventCallback<IRecurrent?> Change { get; set; }

    private static readonly string[] _ogniOpzioni = ["Giorno", "Settimana", "Mese", "Anno"];
    private string? _ogni;

    private async Task OnRecurrenceChanged(IRecurrent recurrence)
    {
        Recurrent = recurrence;
        await RecurrentChanged.InvokeAsync(Recurrent);
        await Change.InvokeAsync(Recurrent);
    }
}

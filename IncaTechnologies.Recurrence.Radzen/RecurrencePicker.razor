<RadzenStack Visible=@Visible>
    <RadzenFormField Text="Ogni">
        <RadzenDropDown @bind-Value=_ogni Data=_ogniOpzioni Change="@(x => OnChanged(null))" />
    </RadzenFormField>

    @if (_ogni is "Giorno")
    {
        <DailyRecurrencePicker Change=OnChanged />
    }
    else if (_ogni is "Settimana")
    {
        <WeeklyRecurrencePicker Change=OnChanged />
    }
    else if (_ogni is "Mese")
    {
        <MonthlyRecurrencePicker Change=OnChanged />
    }
    else if (_ogni is "Anno")
    {
        <YearlyRecurrencePicker Change=OnChanged />
    }
</RadzenStack>

@inherits FormComponent<IRecurrent?>
@using IncaTechnologies.Recurrence
@code 
{
    private static readonly string[] _ogniOpzioni = ["Giorno", "Settimana", "Mese", "Anno"];
    private string? _ogni;

    private async Task OnChanged(IRecurrent? recurrence)
    {
        Value = recurrence;

        await ValueChanged.InvokeAsync(Value);
        await Change.InvokeAsync(Value);
    }
   
}

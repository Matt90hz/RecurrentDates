@page "/"

@using IncaTechnologies.Recurrence
@using IncaTechnologies.Recurrence.Radzen

<PageTitle>Home</PageTitle>

<RadzenTemplateForm TItem="ViewModel" Data=@model Style="width: 1200px; margin: 20px" Submit=OnSubmit InvalidSubmit=OnInvalid>
    <RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal">
            <RadzenButton Text="Use year" Click=@(() => OnUseRecurrenceClick("year")) />
            <RadzenButton Text="Use month" Click=@(() => OnUseRecurrenceClick("month")) />
            <RadzenButton Text="Use week" Click=@(() => OnUseRecurrenceClick("week")) />
            <RadzenButton Text="Use day" Click=@(() => OnUseRecurrenceClick("day")) />
        </RadzenStack>
        <RadzenRow>
            <RadzenColumn>
                <RecurrencePicker Name="picker" @bind-Value=model.Recurrent />
                <RadzenRequiredValidator Component="picker" />
            </RadzenColumn>
            <RadzenColumn>
                <RadzenFieldset Text="Log">
                    <RadzenText Text=@model.Recurrent?.ToFriendlyString() />
                </RadzenFieldset>
            </RadzenColumn>
        </RadzenRow>
        <RadzenButton Text="Submit" ButtonType=ButtonType.Submit />
    </RadzenStack>
</RadzenTemplateForm>

@inject NotificationService _notification
@code
{
    private class ViewModel
    {
        public IRecurrent? Recurrent { get; set; }
    }

    private ViewModel model = new();

    private void OnSubmit()
    {
        _notification.Notify(NotificationSeverity.Success, "Good");
    }

    private void OnInvalid(FormInvalidSubmitEventArgs args)
    {
        _notification.Notify(NotificationSeverity.Error, args.Errors?.First() ?? "");
    }

    private void OnUseRecurrenceClick(string recurrent)
    {
        var newValue = recurrent switch
        {
            "year" => Occurs.EveryYear().In(x =>
            {
                x.February().Day(29);
                x.November().SecondMonday().At(x =>
                {
                    x.Hour(10).Minute(30); x.Hour(21).Minute(30);
                });
            }),

            "month" => Occurs.EveryMonth().The(x => 
            { 
                x.Day(29).Hour(4).Minute(20); 
                x.SecondMonday().At(x => 
                { 
                    x.Hour(10).Minute(30); 
                    x.Hour(21).Minute(30); 
                }); 
            }),

            "week" => Occurs.EveryWeek().On(x => 
            { 
                x.Monday(); x.Friday().At(x => 
                { 
                    x.Hour(10).Minute(30); 
                    x.Hour(21).Minute(30); }); 
            }),

            "day" => Occurs.EveryDay().At(x => 
            { 
                x.Hour(10).Minute(30); 
                x.Hour(21).Minute(30); 
            }),

            _ => null
        };

        model.Recurrent = newValue.GetRoot();
    }
}